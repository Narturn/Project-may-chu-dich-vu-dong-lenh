        <mxCell id="36" parent="1" style="shape=note;size=15;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=1.5;fontColor=#881337;fontFamily=Helvetica;fontSize=11.5;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=8;" value="&lt;b&gt;Quyết định kỹ thuật #4 [ĐỀ XUẤT - CHỜ NHÓM DUYỆT]:&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;Phương án 4A:&lt;/b&gt; &lt;code&gt;Thread-per-connection&lt;/code&gt; (&lt;code&gt;new Thread(handler).start()&lt;/code&gt;).&lt;br&gt;&amp;bull; &lt;b&gt;Phương án 4B [Khuyến nghị]:&lt;/b&gt; &lt;code&gt;Executors.newFixedThreadPool(10)&lt;/code&gt; kết hợp &lt;code&gt;clientSocket.setSoTimeout(60_000)&lt;/code&gt;.&lt;br&gt;&amp;bull; &lt;i&gt;Lưu ý hàng đợi:&lt;/i&gt; Pool cố định giới hạn 10 worker chạy đồng thời; kết nối thứ 11+ xếp vào &lt;code&gt;LinkedBlockingQueue&lt;/code&gt; chờ worker rảnh." vertex="1">
