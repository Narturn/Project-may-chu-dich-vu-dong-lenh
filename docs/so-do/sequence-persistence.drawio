        <mxCell id="80" value="&lt;b&gt;9b.&lt;/b&gt; Kết thúc quá trình lưu trữ &amp;amp; dừng Server" style="html=1;strokeWidth=1.8;strokeColor=#0369a1;dashed=1;dashPattern=6 4;fixDash=1;endArrow=open;endFill=0;endSize=8;fontFamily=Helvetica;fontSize=11.5;fontColor=#0f172a;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;spacingBottom=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="418" y="1475" as="sourcePoint"/>
            <mxPoint x="142" y="1475" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="81" value="&lt;b&gt;GHI CHÚ KỸ THUẬT &amp;amp; PHÂN ĐỊNH TRÁCH NHIỆM:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Tách biệt trách nhiệm Nghiệp vụ và Lưu trữ:&lt;/b&gt; &lt;code&gt;MetricsCollector&lt;/code&gt; chỉ quản lý bộ đếm in-memory (khôi phục trạng thái ở Startup và trích xuất &lt;code&gt;snapshot&lt;/code&gt; ở Shutdown), &lt;b&gt;tuyệt đối không trực tiếp đọc/ghi tệp CSV&lt;/b&gt;. Mọi thao tác tệp (&lt;code&gt;metrics.csv&lt;/code&gt;) và quản lý luồng I/O đều do &lt;code&gt;MetricsRepository&lt;/code&gt; đảm nhiệm.&lt;br&gt;• &lt;b&gt;Quản lý tài nguyên an toàn (Chương 5, Chương 6):&lt;/b&gt; Cả &lt;code&gt;BufferedReader&lt;/code&gt; (Startup) và &lt;code&gt;PrintWriter&lt;/code&gt; (Shutdown) đều được khởi tạo bên trong khối &lt;code&gt;try-with-resources&lt;/code&gt; để đảm bảo tự động đóng (&lt;code&gt;close()&lt;/code&gt;) ngay cả khi xảy ra lỗi I/O.&lt;br&gt;• &lt;b&gt;Trạng thái thiết kế:&lt;/b&gt; Các chữ ký hàm (&lt;code&gt;loadFromCsv&lt;/code&gt;, &lt;code&gt;exportSnapshot&lt;/code&gt;, &lt;code&gt;saveToCsv&lt;/code&gt;), cấu trúc cột CSV, vị trí package của &lt;code&gt;MetricsCollector&lt;/code&gt; / &lt;code&gt;MetricsRepository&lt;/code&gt; và cơ chế &lt;code&gt;JVM ShutdownHook&lt;/code&gt; hiện là &lt;font color='#be185d'&gt;&lt;b&gt;[Đề xuất / Chưa chốt]&lt;/b&gt;&lt;/font&gt; chờ nhóm thống nhất." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#1e293b;fontFamily=Helvetica;fontSize=11.5;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry x="25" y="1545" width="2410" height="98" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
