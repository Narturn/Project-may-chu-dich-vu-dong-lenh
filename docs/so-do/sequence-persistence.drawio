        <mxCell id="73" value="&lt;b&gt;6.&lt;/b&gt; Mở tệp &lt;code&gt;metrics.csv&lt;/code&gt; để ghi dữ liệu" style="html=1;strokeWidth=1.8;strokeColor=#b45309;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11.5;fontColor=#0f172a;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;spacingBottom=3;" edge="1" parent="1">
