        <mxCell id="97" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#1e293b;fontFamily=Helvetica;fontSize=11.5;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;" value="&lt;b&gt;GHI CHÚ KỸ THUẬT &amp;amp; PHÂN ĐỊNH TRÁCH NHIỆM:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Phân biệt 3 điểm phát sinh &amp;amp; bắt lỗi:&lt;/b&gt; (1) &lt;i&gt;Syntax Error&lt;/i&gt; phát sinh tại &lt;code&gt;ProtocolParser&lt;/code&gt;, bắt tại &lt;code&gt;ClientHandler&lt;/code&gt; → &lt;code&gt;ERR_SYNTAX&lt;/code&gt;; (2) &lt;i&gt;Unknown Command&lt;/i&gt; phát hiện tại &lt;code&gt;CommandRegistry&lt;/code&gt;, xử lý tại &lt;code&gt;CommandDispatcher&lt;/code&gt; → &lt;code&gt;ERR_UNKNOWN_COMMAND&lt;/code&gt;; (3) &lt;i&gt;Internal Error&lt;/i&gt; phát sinh tại &lt;code&gt;CommandHandler.apply()&lt;/code&gt;, bắt an toàn tại &lt;code&gt;CommandDispatcher&lt;/code&gt; → &lt;code&gt;ERR_INTERNAL&lt;/code&gt;.&lt;br&gt;• &lt;b&gt;Tách biệt &lt;code&gt;Response&lt;/code&gt; và &lt;code&gt;KetQua&lt;/code&gt;:&lt;/b&gt; &lt;code&gt;Response&lt;/code&gt; thuộc &lt;b&gt;Tầng Giao thức Mạng&lt;/b&gt; (đóng gói chuỗi &lt;code&gt;ERR &amp;lt;ERROR_CODE&amp;gt; &amp;lt;MESSAGE&amp;gt;&lt;/code&gt; gửi qua Socket); trong khi &lt;code&gt;KetQua&lt;/code&gt; (&lt;font color=&#39;#be185d&#39;&gt;&lt;b&gt;[Đề xuất]&lt;/b&gt;&lt;/font&gt;) thuộc &lt;b&gt;Tầng Nghiệp vụ nội bộ&lt;/b&gt;. Phương án &lt;code&gt;CommandException extends RuntimeException&lt;/code&gt; (&lt;font color=&#39;#be185d&#39;&gt;&lt;b&gt;[Đề xuất]&lt;/b&gt;&lt;/font&gt;) giúp tương thích chữ ký &lt;code&gt;Function&amp;lt;String, String&amp;gt;&lt;/code&gt; và đang chờ nhóm thống nhất chính thức." vertex="1">
          <mxGeometry height="96" width="2570" x="25" y="1632" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
