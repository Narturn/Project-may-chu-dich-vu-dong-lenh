            <mxPoint x="1142" y="1005" as="sourcePoint"/>
            <mxPoint x="1142" y="1042" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="1170" y="1005"/>
              <mxPoint x="1170" y="1042"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="58" value="&lt;b&gt;11a.&lt;/b&gt; Đóng gói: &lt;code&gt;Response.ok(statsContent)&lt;/code&gt;&lt;br&gt;&lt;small&gt;&lt;font color='#be185d'&gt;[Đề xuất: hoặc qua KetQua.ThanhCong]&lt;/font&gt;&lt;/small&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=#ffffffd8;fontFamily=Helvetica;fontSize=11.5;fontColor=#0f172a;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1178" y="1005.5" width="240" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="59" value="&lt;b&gt;11b.&lt;/b&gt; Trả về &lt;code&gt;Response.ok(statsContent)&lt;/code&gt;" style="html=1;strokeWidth=1.8;strokeColor=#5b21b6;dashed=1;dashPattern=6 4;fixDash=1;endArrow=open;endFill=0;endSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;spacingBottom=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1128" y="1085" as="sourcePoint"/>
            <mxPoint x="872" y="1085" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="60" value="&lt;b&gt;12.&lt;/b&gt; Ghi phản hồi: &lt;code&gt;write(&amp;quot;OK &amp;quot; + statsContent + &amp;quot;\n&amp;quot;)&lt;/code&gt;" style="html=1;strokeWidth=1.8;strokeColor=#15803d;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;spacingBottom=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="858" y="1130" as="sourcePoint"/>
            <mxPoint x="612" y="1130" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="61" value="&lt;b&gt;13a.&lt;/b&gt; Nhận phản hồi: &lt;code&gt;readLine()&lt;/code&gt; → &lt;code&gt;&amp;quot;OK ...&amp;quot;&lt;/code&gt;" style="html=1;strokeWidth=1.8;strokeColor=#0369a1;dashed=1;dashPattern=6 4;fixDash=1;endArrow=open;endFill=0;endSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;spacingBottom=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="598" y="1170" as="sourcePoint"/>
            <mxPoint x="352" y="1170" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="62" value="&lt;b&gt;13b.&lt;/b&gt; Hiển thị kết quả thống kê" style="html=1;strokeWidth=1.8;strokeColor=#0369a1;dashed=1;dashPattern=6 4;fixDash=1;endArrow=open;endFill=0;endSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=center;spacingBottom=4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="338" y="1210" as="sourcePoint"/>
            <mxPoint x="115" y="1210" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="63" value="&lt;b&gt;GHI CHÚ KỸ THUẬT &amp;amp; QUY TẮC UML:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;An toàn luồng khi thống kê (Bước 6–8):&lt;/b&gt; &lt;code&gt;MetricsCollector&lt;/code&gt; tạo một &lt;b&gt;snapshot&lt;/b&gt; độc lập từ dữ liệu đồng thời (ví dụ: &lt;code&gt;ConcurrentHashMap&lt;/code&gt;, &lt;code&gt;AtomicInteger&lt;/code&gt;) trước khi trả về cho &lt;code&gt;StatsHandler&lt;/code&gt;; tuyệt đối không chạy Stream trực tiếp trên cấu trúc đang được các luồng khác cập nhật.&lt;br&gt;• &lt;b&gt;Phân định trách nhiệm:&lt;/b&gt; &lt;code&gt;MetricsCollector&lt;/code&gt; quản lý trạng thái bộ đếm &amp;amp; cung cấp snapshot; &lt;code&gt;StatsHandler&lt;/code&gt; xử lý nghiệp vụ thống kê; &lt;b&gt;Java Streams API&lt;/b&gt; (viền đứt xanh lam) là &lt;i&gt;cơ chế xử lý dữ liệu hàm&lt;/i&gt; (&lt;code&gt;stream → filter → groupingBy → sorted → collect&lt;/code&gt;), không phải một đối tượng nghiệp vụ độc lập.&lt;br&gt;• &lt;b&gt;Chú giải ký hiệu:&lt;/b&gt; &amp;nbsp; &lt;b&gt;──▶&lt;/b&gt; Lời gọi phương thức (Synchronous Call) &amp;nbsp;|&amp;nbsp; &lt;b&gt;- - &amp;gt;&lt;/b&gt; Kết quả trả về (Return) &amp;nbsp;|&amp;nbsp; &lt;b&gt;❚&lt;/b&gt; Activation Bar &amp;nbsp;|&amp;nbsp; &lt;font color='#be185d'&gt;&lt;b&gt;[Đề xuất / Viền đứt đỏ]&lt;/b&gt;&lt;/font&gt;: Chi tiết kỹ thuật chờ nhóm thống nhất chính thức." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#1e293b;fontFamily=Helvetica;fontSize=11.5;verticalAlign=middle;align=left;spacingLeft=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry x="25" y="1262" width="2370" height="96" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
